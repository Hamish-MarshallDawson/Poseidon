# Copy to backend/.env and fill in. Never commit .env.

# AISStream API key (https://aisstream.io, sign in with GitHub, then API Keys).
AISSTREAM_API_KEY=
# Bounding box as (lon, lat) corners. Empty means the whole world. Baltic: [[19,54],[31,61]]
AIS_BBOX=

# Tiger Cloud service URL (TIMESCALE_SERVICE_URL in the credentials file Tiger gives you),
# e.g. postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require. Empty means JSONL log only.
TIGER_DATABASE_URL=

# Where the raw JSONL log goes, relative to backend/.
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed by CORS (the Vite dev server).
FRONTEND_ORIGINS=http://localhost:5173

# Milestone 2 (not used yet): Auth0 tenant domain without https://, and the API identifier (audience).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
