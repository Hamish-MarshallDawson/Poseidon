# One unattended improvement cycle (python -m ml.auto). Installed by ml/deploy/README.md; triggered by dvm-ml.timer.
[Unit]
Description=POSEIDON ML improvement cycle (recalibrate from the ledger, retrain, evaluate, promote)
After=network-online.target dvm.service

[Service]
Type=oneshot
User=dvm
WorkingDirectory=/opt/dvm
EnvironmentFile=/opt/dvm/backend/.env
Environment=POSEIDON_DATA=/opt/dvm/ml-data
Environment=PREDICT_MODEL_DIR=/opt/dvm/models
Environment=ML_THREADS=3
Environment=ML_DEPLOY_RETRAINED=0
Environment=ML_DEPLOY_RECAL=0
ExecStart=/opt/dvm/ml/.venv/bin/python -m ml.auto --targets godark,fishing,route --rounds 1 --proposals 3
Nice=19
IOSchedulingClass=idle
CPUQuota=300%
MemoryMax=6G
TimeoutStartSec=2h
