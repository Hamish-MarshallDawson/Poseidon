# Dark Vessel Monitor: copy this file to .env in the repo root and fill in the blanks.
#   cp .env.example .env
# .env is git-ignored. Never commit it, and never paste keys into the board, a PR or chat.
# Vite only exposes VITE_-prefixed values to the browser; the rest stay server-side.

# ---------------------------------------------------------------------------
# AISStream: live ship positions
# Get a key: https://aisstream.io, sign in with GitHub, then API Keys.
# RULE: one running backend per key (backend/dvm/limits.py). Stop it with
# Ctrl+C, never a force-kill. Aiden's desktop runs the team backend (from
# 7 Nov 22:03), so you only need your own key if you run a separate backend.
AISSTREAM_API_KEY=

# ---------------------------------------------------------------------------
# Tiger Data (Tiger Cloud / TimescaleDB): positions, statics, coverage aggregates
# Use your own Tiger Cloud service (https://console.cloud.timescale.com, the
# service URL from the credentials file), or ask Hamish for the shared one in
# person. Format: postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
# Leave empty to run with the raw JSONL log only.
TIGER_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth0: login. These are public values shared by the whole team (Hamish's
# tenant), so leave them as they are.
AUTH0_DOMAIN=hedgedbets-hacktheburgh.uk.auth0.com
AUTH0_AUDIENCE=https://api.dark-vessel-monitor
AUTH0_ISSUER=https://hedgedbets-hacktheburgh.uk.auth0.com/

# ---------------------------------------------------------------------------
# Frontend (Vite). Keep the dev server on port 5173: Auth0 only allows
# http://localhost:5173 as a callback.
VITE_WS_URL=ws://localhost:8000/ws
VITE_AUTH0_DOMAIN=hedgedbets-hacktheburgh.uk.auth0.com
VITE_AUTH0_CLIENT_ID=XYVmFNiyeduk9gu9HCTBLPlBqnC0sfUJ
VITE_AUTH0_AUDIENCE=https://api.dark-vessel-monitor

# ---------------------------------------------------------------------------
# AI briefing (backend/dvm/briefing): POST /briefing and /briefing/speech.
# Without GEMINI_API_KEY, /briefing returns 503; without ELEVENLABS_API_KEY
# there is no voiceover (voice_available: false). Server-side only.
# Gemini key: https://aistudio.google.com/apikey
# ElevenLabs key: https://elevenlabs.io/app/settings/api-keys
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # ElevenLabs premade "George" (public ID); never leave it empty

# ---------------------------------------------------------------------------
# Optional backend settings (defaults shown)
# AIS_BBOX=                      # empty = whole world; Baltic: [[19,54],[31,61]]
# DATA_DIR=data
# HOST=127.0.0.1
# PORT=8000
# FRONTEND_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional: an Auth0 test user for the frontend smoke test (npm run smoke).
# AUTH0_TEST_EMAIL=
# AUTH0_TEST_PASSWORD=
